# Copy this file to .env and fill in real values for local development.
# .env is gitignored. Never commit credentials.

# --- YouTube transcript proxy (optional — bypasses cloud IP block) -----------
# GitHub Actions IPs are blocked by YouTube's transcript endpoint.
# Without a proxy, the pipeline falls back to the short video description.
#
# Option A: Webshare residential proxy (recommended, free tier sufficient)
#   Sign up at https://proxy.webshare.io/register
#   Find proxy username/password under Proxy → Overview (not your login credentials)
WEBSHARE_PROXY_USERNAME=
WEBSHARE_PROXY_PASSWORD=
#
# Option B: Any HTTP/HTTPS proxy URL
# YOUTUBE_PROXY_URL=http://user:pass@myproxy.example.com:8080

# --- YouTube Data API (required for YouTube source) -----------------------
# Enable "YouTube Data API v3" at https://console.developers.google.com/
# Free tier: 10,000 units/day (ample for daily digest with a few channels)
YOUTUBE_API_KEY=AIza...

# --- Email (pick one provider) -------------------------------------------

# Option A: Resend — free tier (3 000 emails/month), easiest to set up
EMAIL_PROVIDER=resend
RESEND_API_KEY=re_...
EMAIL_SENDER=onboarding@resend.dev   # use your verified domain in production
EMAIL_RECIPIENT=you@example.com

# Option B: Gmail — requires 2FA enabled + an App Password
# EMAIL_PROVIDER=gmail
# EMAIL_SENDER=you@gmail.com
# EMAIL_PASSWORD=xxxx-xxxx-xxxx-xxxx
# EMAIL_RECIPIENT=you@example.com

# Option C: SendGrid
# EMAIL_PROVIDER=sendgrid
# EMAIL_SENDER=you@yourdomain.com
# EMAIL_PASSWORD=SG....
# EMAIL_RECIPIENT=you@example.com

# --- MCP server keys (optional) -------------------------------------------
# Brave Search MCP — get a free key at https://brave.com/search/api/
BRAVE_API_KEY=BSA...

# Tavily MCP — AI-powered search/extract/crawl — get a free key at https://app.tavily.com/home
TAVILY_API_KEY=tvly-...

# --- AI summarisation (optional, free via Google AI Studio) ---------------
# Get a free key at: https://aistudio.google.com
# Leave unset or set summary.enabled: false in sources.yaml to skip Claude
# and receive a plain link list instead.
GEMINI_API_KEY=AIza...
